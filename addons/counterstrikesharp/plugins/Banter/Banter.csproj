<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Banter</AssemblyName>
    <RootNamespace>Banter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="18.1.0" GeneratePathProperty="true" />
    <ProjectReference Include="../../shared/BotChatApi/BotChatApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="lang/*.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgYamlDotNet)/lib/$(TargetFramework)/YamlDotNet.dll"
          Link="YamlDotNet.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
