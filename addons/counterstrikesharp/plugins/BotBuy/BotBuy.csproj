<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BotBuyPatch</RootNamespace>
    <AssemblyName>BotBuy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.373" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" GeneratePathProperty="true" />
    <ProjectReference Include="../../shared/BotChatApi/BotChatApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="lang/*.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="$(PkgYamlDotNet)/lib/$(TargetFramework)/YamlDotNet.dll"
          Link="YamlDotNet.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
